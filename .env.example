# Copy this file to `.env` and fill in your values.
# The Storefront PUBLIC access token is safe to expose in client-side code.

VITE_SHOPIFY_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-public-storefront-access-token

# false → "Coming Soon" mode (nothing sells). true → live products, cart & checkout.
VITE_STORE_LIVE=false

# Meta (Facebook/Instagram) Pixel ID from Meta Events Manager.
# Leave empty to disable the pixel entirely (it never loads without this).
VITE_META_PIXEL_ID=


# GA4 Measurement ID. Empty → falls back to the current property G-RW6PTBGKVB.
VITE_GA_MEASUREMENT_ID=
